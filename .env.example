SOUNDSPLIT_ENV=development

# Desktop API target used by the Vite/Tauri web shell.
# VITE_API_ENVIRONMENT accepts: development, staging, production.
# Leave VITE_API_BASE_URL unset to use the local default below.
VITE_API_ENVIRONMENT=development
VITE_API_BASE_URL=http://127.0.0.1:8000

POSTGRES_USER=soundsplit
POSTGRES_PASSWORD=soundsplit
POSTGRES_DB=soundsplit
DATABASE_URL=postgresql+psycopg://soundsplit:soundsplit@localhost:5432/soundsplit

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=soundsplit
S3_SECRET_ACCESS_KEY=soundsplit-secret
S3_BUCKET=soundsplit-local

API_HOST=127.0.0.1
API_PORT=8000

# Derived, rebuildable knowledge index. Keep NOTION_TOKEN in the environment or ignored MCP config.
KNOWLEDGE_DATABASE_URL=postgresql://soundsplit:soundsplit@localhost:5432/soundsplit
NOTION_KNOWLEDGE_ROOT_ID=3d381a9a-01d0-811a-beb0-d6bcd51cc668
KNOWLEDGE_EMBEDDING_URL=http://127.0.0.1:8091
KNOWLEDGE_MAX_AGE_HOURS=24
KNOWLEDGE_MIN_SIMILARITY=0.45
